    "/users/@me/guilds": {
      "get": {
        "tags": [
          "crate::routes::users"
        ],
        "operationId": "get_user_guilds",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Guild"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CaseId": {
        "type": "string"
      },
      "FluxerUser": {
        "type": "object",
        "required": [
          "discriminator",
          "id",
          "is_staff",
          "username"
        ],
        "properties": {
          "avatar": {
            "type": [
              "string",
              "null"
            ]
          },
          "discriminator": {
            "type": "string"
          },
          "global_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string"
          },
          "is_staff": {
            "type": "boolean"
          },
          "username": {
            "type": "string"
          }
        }
      },
      "Guild": {
        "type": "object",
        "required": [
          "id",
          "name",
          "owner_id"
        ],
        "properties": {
          "banner": {
            "type": [
              "string",
              "null"
            ]
          },
          "icon": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string"
          },
          "member_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "name": {
            "type": "string"
          },
          "online_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "owner_id": {
            "type": "string"
          },
          "splash": {
            "type": [
              "string",
              "null"
            ]
          },
          "vanity_url_code": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "GuildConfig": {
        "type": "object",
        "required": [
          "command_prefixes"
        ],
        "properties": {
          "command_prefixes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "GuildModerationCaseCloseDataResponse": {
        "type": "object",
        "properties": {
          "closed_by": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "GuildModerationCaseExpiry": {
        "type": "object",
        "required": [
          "expires_at",
          "duration"
        ],
        "properties": {
          "duration": {
            "type": "string"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "GuildModerationCaseResponse": {
        "type": "object",
        "required": [
          "case_id",
          "guild_id",
          "target_id",
          "moderation_kind",
          "created_at"
        ],
        "properties": {
          "case_id": {
            "$ref": "#/components/schemas/CaseId"
          },
          "close_data": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/GuildModerationCaseCloseDataResponse",
                "description": "`None` if the case is not closed."
              }
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "expiry": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/GuildModerationCaseExpiry"
              }
            ]
          },
          "guild_id": {
            "type": "string"
          },
          "moderation_kind": {
            "$ref": "#/components/schemas/ModerationKind"
          },
          "moderator_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "target_id": {
            "type": "string"
          }
        }
      },
      "GuildModerationCasesResponseSchema": {
        "type": "object",
        "required": [
          "cases",
          "total",
          "has_next"
        ],
        "properties": {
          "cases": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GuildModerationCaseResponse"
            }
          },
          "has_next": {
            "type": "boolean"
          },
          "total": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "GuildUpdates": {
        "type": "object",
        "properties": {
          "command_prefixes": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ModerationKind": {
        "type": "string",
        "enum": [
          "Warn",
          "Mute",
          "Kick",
          "Ban"
        ]
      }
    }
  }
}
